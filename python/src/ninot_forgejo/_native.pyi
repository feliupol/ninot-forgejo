from types import TracebackType

from typing_extensions import Self

from .models import (
    ActionJobSeed,
    ActionRunSeed,
    ActionTaskSeed,
    CommitStatusSeed,
    ProfileHit,
    RequestTrace,
    TimelineEventSeed,
)

class ScheduledMergeInfo:
    @property
    def merge_method(self) -> str: ...
    @property
    def delete_branch(self) -> bool: ...

class PullRequest:
    @property
    def index(self) -> int: ...
    def request_review(self, login: str) -> None: ...
    def scheduled_merge(self) -> ScheduledMergeInfo | None: ...
    def create_timeline_event(self, seed: TimelineEventSeed) -> None: ...

class ActionRun:
    @property
    def id(self) -> int: ...
    def script_status_frames(self, frames: list[list[str]]) -> None: ...
    def set_job_log(self, job_index: int, log: str) -> None: ...

class Repository:
    @property
    def owner(self) -> str: ...
    @property
    def name(self) -> str: ...
    def set_description(self, description: str) -> None: ...
    def commit_file(
        self,
        branch: str,
        path: str,
        content: str,
        message: str = "Update fixture",
        executable: bool | None = None,
    ) -> str: ...
    def create_branch(self, branch: str, reference: str = "main") -> None: ...
    def create_label(self, label: str, color: str = "00ff00") -> int: ...
    def create_commit_status(self, seed: CommitStatusSeed) -> int: ...
    def pull_request(self, index: int) -> PullRequest: ...
    def create_pull_request(
        self,
        head: str,
        base: str = "main",
        title: str = "Fixture pull request",
        body: str = "",
        author: str = "admin",
        labels: list[str] | None = None,
        draft: bool = False,
    ) -> PullRequest: ...
    def create_action_task(self, task: ActionTaskSeed) -> int: ...
    def create_action_secret(self, secret_name: str) -> None: ...
    def action_secret_names(self) -> list[str]: ...
    def create_action_run(self, run: ActionRunSeed, jobs: list[ActionJobSeed]) -> ActionRun: ...
    def script_workflow_dispatch(
        self,
        workflow_filename: str,
        reference: str,
        inputs: dict[str, str],
        run: ActionRun,
    ) -> None: ...
    def set_delete_branch_after_merge(self, enabled: bool) -> None: ...
    def advance(self) -> int: ...

class User:
    @property
    def id(self) -> int: ...
    @property
    def login(self) -> str: ...
    def set_profile(self, full_name: str, email: str = "") -> None: ...
    def create_token(self, scopes: list[str]) -> str: ...
    def create_repository(
        self,
        name: str,
        private: bool = False,
        default_branch: str = "main",
        auto_init: bool = True,
    ) -> Repository: ...

class Server:
    def __init__(self, tls: bool = False) -> None: ...
    @property
    def url(self) -> str: ...
    @property
    def ca_cert_path(self) -> str | None: ...
    @property
    def api_url(self) -> str: ...
    @property
    def admin_token(self) -> str: ...
    def create_user(self, login: str) -> User: ...
    def user(self, login: str) -> User: ...
    def repository(self, owner: str, name: str) -> Repository: ...
    def stop(self) -> None: ...
    def start_profile(self) -> None: ...
    def start_request_trace(self) -> None: ...
    def stop_request_trace(self) -> RequestTrace: ...
    def fail_next(self, method: str, path: str, status: int) -> None: ...
    def delay_next(self, method: str, path: str, milliseconds: int) -> None: ...
    def clear_faults(self) -> None: ...
    def stop_profile(self) -> list[ProfileHit]: ...
    def __enter__(self) -> Self: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None = None,
        exc_val: BaseException | None = None,
        exc_tb: TracebackType | None = None,
    ) -> None: ...
